  },
  {
   "seq": "14",
   "text": "又やみむかたのゝみのゝ桜かり花の雪ち類するのあけほの",
   "kana": "",
   "speaker": "俊成卿",
   "page": 2,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "一久かたのひかりのとけれ春の日にしつ心なく花のちるらん",
   "kana": "",
   "speaker": "紀友則",
   "page": 3,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "あすよりは志賀の国そのまれにたに誰かは問ん春の古郷",
   "kana": "",
   "speaker": "後京極摂政大政大臣",
   "page": 3,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "春過て夏きにけらし白妙の宿ほすてふあまのかくやま",
   "kana": "",
   "speaker": "地統天皇",
   "page": 3,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "一見渡せは浪のしからみかけてけり卯の圖咲る玉川の里",
   "kana": "",
   "speaker": "相模",
   "page": 3,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "五月雨はたくものけふり打しめるしほたれまさる須磨の浦人",
   "kana": "",
   "speaker": "俊成卿",
   "page": 3,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "道のへに清水なかるゝ柳かけしはしとてこそ立とまりつれ",
   "kana": "",
   "speaker": "西行法師",
   "page": 3,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "おのつから涼しくもあるかなつ夜日も夕くれの面の名残に",
   "kana": "",
   "speaker": "清輔朝臣",
   "page": 3,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "いつとてもおしくやはあらぬ年月をみそきにすつ日夏の暮哉",
   "kana": "",
   "speaker": "俊成卿",
   "page": 3,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "秋たちていくかもあらねとこのねぬる朝気の風は快涼しも",
   "kana": "",
   "speaker": "安貴王",
   "page": 3,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "八色葎しけれる宿のさひしきに人こそみえね秋は木にけり",
   "kana": "",
   "speaker": "恵慶法師",
   "page": 3,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "秋はきぬ年も半に過ぬとや萩吹風のおとろかすらん",
   "kana": "",
   "speaker": "一突然法師",
   "page": 4,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "あわれいかに草塗の歌のこほるらん秋風立ぬ宮蝶のゝゑし",
   "kana": "",
   "speaker": "西行法師",
   "page": 4,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "月みれはちゝにものこそかなしけれ我身ひとつの秋にはあらねど",
   "kana": "",
   "speaker": "大江千里",
   "page": 4,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "古里の哥とあらのに蘇咲しより夜な〳〵庭の月そうつろふ",
   "kana": "",
   "speaker": "後京極摂政",
   "page": 4,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "あすもこん野七の玉川萩こへて色なる浪に月やとりけり",
   "kana": "",
   "speaker": "源俊頼",
   "page": 4,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "詠めつゝ思ふも・淋し久かたの月の都のあけかたのそら",
   "kana": "",
   "speaker": "家隆",
   "page": 4,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "秋の露や袂にいたく結らん長夜あかすやとる月哉と",
   "kana": "",
   "speaker": "後鳥羽院",
   "page": 4,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "鳴わたるかりの涙や落つらんもの思ふ宿の萩の上露",
   "kana": "",
   "speaker": "読人しらす",
   "page": 4,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "萩か花敷らんに野の露霜にぬれておきませさ夜は更とも",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "秋の田のかりほの廬のとまをあらみ我最手は露にぬれつゝ",
   "kana": "",
   "speaker": "天智天皇",
   "page": 4,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "白露に風の吹しく秋の野はつらぬきとめぬ玉そちりける",
   "kana": "",
   "speaker": "文屋朝康",
   "page": 5,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "立田姫かさしの玉のをゝよわみみたれにけりとみゆるしら露",
   "kana": "",
   "speaker": "藤原清輔朝臣",
   "page": 5,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "一白雲をつはさにかけり行雁の門田の面の友したふなる",
   "kana": "",
   "speaker": "西行法師",
   "page": 5,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "秋風にさそはれ渡るかりかねはもの思ふ人の宿をよくらん",
   "kana": "",
   "speaker": "よみ人しらす",
   "page": 5,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "千度うつ煤の音に夢さめて物思ふ袖の露そくたくる",
   "kana": "",
   "speaker": "式子内数王",
   "page": 5,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "はるかなるもろこしまても行ものは秋のねさめの心なりけり",
   "kana": "",
   "speaker": "大弐三位",
   "page": 5,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "夕されは門田のいなはをとつれて芦のまろやに秋風そふく",
   "kana": "",
   "speaker": "大納言",
   "page": 5,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "淋しさは其色としもなかりけり横たつ山の秋の夕くれ",
   "kana": "",
   "speaker": "一寂蓮法",
   "page": 5,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "吹からに秋の草木のしほなれはむへ山風をあらしといふらん",
   "kana": "",
   "speaker": "文屋康秀",
   "page": 5,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "さほしかの妻とふ山の恩へなる早田はからし霜はおくとも",
   "kana": "",
   "speaker": "人丸",
   "page": 5,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "おく山にもみちふみわけ鳴鹿のこゑきく時そ秋そかなしき",
   "kana": "",
   "speaker": "よみ人しらす",
   "page": 6,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "秋風の以上にたてる白菊は花かあらぬるなみのよするか",
   "kana": "",
   "speaker": "菅家",
   "page": 6,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "心あてにをらはやおらん初霜のをきまとはせる白きくの図",
   "kana": "",
   "speaker": "凡河内躬恒",
   "page": 6,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "しら露も時雨もいたく守山は下柴のこらすいろつきにけり",
   "kana": "",
   "speaker": "貫之",
   "page": 6,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "立田川もみちなりるゝ神なひのみむろの山に伝雨ふるゝし",
   "kana": "",
   "speaker": "人丸",
   "page": 6,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "袂はきぬもみちは宿にふり敷ぬ道ふみわけてとふ人はなし",
   "kana": "",
   "speaker": "読人しらす",
   "page": 6,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "千早振神代もきかす立田川からくれなゐに水くゝるとは",
   "kana": "",
   "speaker": "在原業平",
   "page": 6,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "山川に風のかけたるしからみはなかれもあへぬもみちなりけり",
   "kana": "",
   "speaker": "春道列樹",
   "page": 6,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "ほの〳〵とあり雨の月の月影にもみち吹おろす山嵐の風",
   "kana": "",
   "speaker": "源信時",
   "page": 6,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "深みとりあらそひかねていかならんまなく時雨のふるの神杉",
   "kana": "",
   "speaker": "後鳥羽院",
   "page": 6,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "秋しのやと山の里や時雨らん生駒のたけに雲のかゝれる",
   "kana": "",
   "speaker": "西行法師",
   "page": 7,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "冬かれのもりの朽葉の霜の上に落たる露の影のさやけさ",
   "kana": "",
   "speaker": "清輔朝臣",
   "page": 7,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "君こすは独やねなんさゝのはのみ山もそよにさやく霜夜を",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "かたしきの袖の氷もむすほゝ迄とけてねぬ夜の夢そみしかき",
   "kana": "",
   "speaker": "後京極摂政大政大臣",
   "page": 7,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "やたのゝにあさち色つくあらち山嶺の漢雪さむくそあるらし",
   "kana": "",
   "speaker": "人丸",
   "page": 7,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "古里はよしのゝ山しをけれはひと日もみ雪ふやふらぬ日はなみ",
   "kana": "",
   "speaker": "読人しらす",
   "page": 7,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "今よりはつきてふらなん我宿の薄おしなみふれるしゝ雪",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "朝ほらけあり湖の月をみるまてに吉野の里にふれるしら雪",
   "kana": "",
   "speaker": "坂上是則",
   "page": 7,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "石とふるのゝ小篠霜をへて一夜はかりなのこるとしうな",
   "kana": "",
   "speaker": "後京極",
   "page": 7,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "君か代はつきしとそ思ふ神風やみもすそ川のすまんかきりは",
   "kana": "",
   "speaker": "経信",
   "page": 7,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "末の露もとの雫や世の中のをくれさきたつためし成らん",
   "kana": "",
   "speaker": "僧正遍昭",
   "page": 8,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "皆人は花の衣に成ぬなり苔のたもきにかわきたにせよ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "諸ともに苔の下には朽すして埋れぬ名を見るそ悲しき",
   "kana": "",
   "speaker": "和泉式部",
   "page": 8,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "かきりあれはけふぬき捨る藤衣はてなきものは涙なりけり",
   "kana": "",
   "speaker": "藤原道信朝臣",
   "page": 8,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "おもひ出るをりたく柴の夕有ふりむせふも嬉しわすれかたみに",
   "kana": "",
   "speaker": "後鳥羽院",
   "page": 8,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "なき人のかたみの袖やしほるらん夕の物に色は見へねと",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "立別れいなはの山の嶺に生ふ松としきかは今帰りこん",
   "kana": "",
   "speaker": "中納言行平",
   "page": 8,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "一白雲の八重に重る遂にても思はん人にこゝろへたつな",
   "kana": "",
   "speaker": "母貝也",
   "page": 8,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "わくらはにとふ人あらは須磨の浦にもしほたれつゝわふと答に",
   "kana": "",
   "speaker": "行平",
   "page": 8,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "此たひはぬさもとりあへす手向山もみちのにしき神のまに〳〵",
   "kana": "",
   "speaker": "菅家",
   "page": 8,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "難波人芦火多くやに宿かりてすゝろに袖のしほたるゝかな",
   "kana": "",
   "speaker": "俊成",
   "page": 9,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "立帰りまたもきてみん松島や小島のとまや波にあらすな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "明はまたこゆへき山の嶺なれや空行月の末のしらくも",
   "kana": "",
   "speaker": "家隆朝臣",
   "page": 9,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "一難波江のもにうつれるゝ玉かしはあらはれてたふ人を恋はや",
   "kana": "",
   "speaker": "俊頼朝臣",
   "page": 9,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "東路の御のゝ舟橋かけてのみ思ひやたるをしる人のなき",
   "kana": "",
   "speaker": "読人しらす",
   "page": 9,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "あきちふの小野のしのゑの原忍ふれとあまりておとか。人の恋しき",
   "kana": "",
   "speaker": "参議等",
   "page": 9,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "いかにせん室の八島に宿もかなこひのけふりを空まかへん",
   "kana": "",
   "speaker": "俊成",
   "page": 9,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "夕書は雲のはたてにものそ思ふあまつくなる人をこふとて",
   "kana": "",
   "speaker": "読人しらす",
   "page": 9,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "難波かたみしかきあしのふしの間もあいてこの世を過してよとや",
   "kana": "",
   "speaker": "伊勢",
   "page": 9,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "うかりける人を初瀬の山おろしはけしかれとはいのゝりぬものを",
   "kana": "",
   "speaker": "俊頼",
   "page": 9,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "瀬をはやみ岩にせかるゝ滝川のわれてもす夜にあはんとそ思ふ",
   "kana": "",
   "speaker": "崇徳院",
   "page": 10,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "おもひ川絶すなりるゝ水の淡のうたかた人にあわて消めや",
   "kana": "",
   "speaker": "伊勢",
   "page": 10,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "なき名のみたつの市とはさは市ともいさまた人とうるとしもなし",
   "kana": "",
   "speaker": "人丸",
   "page": 10,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "かた糸をこなたかなたによりかけてあわすは何を玉の緒にせん",
   "kana": "",
   "speaker": "読人しらす",
   "page": 10,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "思ひ艸葉末にむすふ国露のたま〳〵きては手にもとられす",
   "kana": "",
   "speaker": "俊頼",
   "page": 10,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "思ひきやしちのはしかきかきつめて百夜も同しまろねせんとは",
   "kana": "",
   "speaker": "俊成",
   "page": 10,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "有明のつれなくみえしわかれよりあかつきはかりうきものはなし",
   "kana": "",
   "speaker": "壬生忠岑",
   "page": 10,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "名取川瀬々の埋木あらはれはいかにせんとかあひみ初けん",
   "kana": "",
   "speaker": "よみ人しらす",
   "page": 10,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "今こんといひしはかりに長月の有済の月をまち出るかな",
   "kana": "",
   "speaker": "素埋法師",
   "page": 10,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "逢ことは遠山鳥のかり衣きてはかひなき音をのみそなく",
   "kana": "",
   "speaker": "元良親王",
   "page": 10,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "足曳の山鳥の尾のしたり尾のなる〳〵し夜をひとりかもねん",
   "kana": "",
   "speaker": "人丸",
   "page": 11,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "侘ぬれば今はたおなし難渋なる身をつくしてもあわんとそ思ふ",
   "kana": "",
   "speaker": "元良親王",
   "page": 11,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "我恋は庭の村萩うら枯て人をも身をもあきのゆふくれ",
   "kana": "",
   "speaker": "前大僧正慈園",
   "page": 11,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "袖の露もあらぬ色にそ消かへる移れはかわる歎せしまに",
   "kana": "",
   "speaker": "後鳥羽院",
   "page": 11,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "思ひいつるときはの山の岩つゝしいはねはこそあれ恋しき物を",
   "kana": "",
   "speaker": "読人しらす",
   "page": 11,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "契りきな形見に袖をしほりつゝ末のまつ山流こさしとは",
   "kana": "",
   "speaker": "元輔",
   "page": 11,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "歎けとて月やはものを思はするかみちかほなる我なみたかな",
   "kana": "",
   "speaker": "西行法師",
   "page": 11,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  }
 ],
