   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "君かため春の野に出て若菜つむ我衣手にゆきはふりつゝ",
   "kana": "",
   "speaker": "光孝天皇",
   "page": 1,
   "pid": "nao-732994",
   "form": "短歌",
   "genre": "",
   "ban": "",
