 "poems": [
  {
   "seq": "1",
   "text": "一春たつといふはかりにや深よしのゝ山も霞てけさは見ゆらん",
   "kana": "",
   "speaker": "壬生忠岑",
   "page": 1,
   "pid": "nao-732994",
